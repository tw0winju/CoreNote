{
  "name": "corenote",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "PDF를 색인해두고 내 자료 전체에 질문하는 로컬 RAG 학습 도우미 (Ollama, Windows 10 64bit)",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "preview": "npm run build && node server.js",
    "lint": "eslint src server.js",
    "lint:fix": "eslint --fix src server.js",
    "format": "prettier --write src server.js",
    "format:check": "prettier --check src server.js"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "apache-arrow": "^21.1.0",
    "canvas": "^3.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.0.227",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^8.0.7",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "vite": "^5.4.10"
  }
}
