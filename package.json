{
  "name": "corenote",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "PDF를 올리면 로컬 LLM(Ollama)이 요약·핵심개념·암기포인트·복습퀴즈로 정리해주는 학습 도우미 (Windows 10 64bit)",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "start": "node server.js",
    "preview": "npm run build && node server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "vite": "^5.4.10"
  }
}
