# 이 파일은 선택사항입니다. 아무것도 안 해도 기본값으로 동작합니다.
# 값을 바꾸려면 이 파일을 복사해 .env 로 만드세요.
#   PowerShell:  Copy-Item .env.example .env
#   명령 프롬프트(cmd):  copy .env.example .env

# 사용할 Ollama 모델 (미리 'ollama pull' 필요). 기본값: qwen3:8b
# 8GB VRAM(RTX 3070)에 맞는 추천: qwen3:8b, llama3.1:8b
# 품질을 더 원하면(조금 느려짐): qwen3:14b
OLLAMA_MODEL=qwen3:8b

# Ollama 서버 주소. 기본값: http://localhost:11434
OLLAMA_URL=http://localhost:11434

# 한 청크의 최대 글자 수. 8GB VRAM 기준 보수적으로 6000. 기본값: 6000
MAX_CHUNK_CHARS=6000

# 처리할 최대 청크 수(아주 긴 문서 안전장치). 기본값: 12
MAX_CHUNKS=12

# 백엔드 포트. 기본값: 3001
PORT=3001
